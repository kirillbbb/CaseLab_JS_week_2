            },
            "event": [
              {
                "listen": "test",
                "script": {
                  "type": "text/javascript",
                  "exec": "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));\npm.test('Status is ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
